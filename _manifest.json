{
  "manifest_version": 2,
  "version": "1.2.1",
  "name": "NovelAI Web 图片生成插件（nai_pic_plugin）",
  "description": "与 nai_low_plugin 保持同一套命令、提示词、撤回、管理员和检索逻辑，仅底层请求仍走 NovelAI Web API。",
  "author": {
    "name": "Rabbit",
    "url": "https://github.com/Rabbit-Jia-Er"
  },
  "license": "GPL-v3.0-or-later",
  "urls": {
    "repository": "https://github.com/Rabbit-Jia-Er/nai_pic_plugin",
    "homepage": "https://github.com/Rabbit-Jia-Er/nai_pic_plugin",
    "documentation": "https://github.com/Rabbit-Jia-Er/nai_pic_plugin",
    "issues": "https://github.com/Rabbit-Jia-Er/nai_pic_plugin/issues"
  },
  "host_application": {
    "min_version": "0.10.0",
    "max_version": "1.0.0"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "config.get_all",
    "message.get_recent",
    "send.command",
    "send.custom",
    "send.text",
    "network.http"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "rabbit.nai-pic-plugin"
}
